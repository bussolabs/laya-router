{
  "name": "@bussolabs/laya-router",
  "version": "0.1.0",
  "description": "Runs coding CLIs and routes each turn to the cheapest sufficient model using Laya, locally or on a laya-serve server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bussolabs/laya-router.git"
  },
  "homepage": "https://github.com/bussolabs/laya-router#readme",
  "bugs": "https://github.com/bussolabs/laya-router/issues",
  "type": "module",
  "bin": {
    "laya-claude": "bin/laya-claude.mjs",
    "laya-codex": "bin/laya-codex.mjs",
    "laya-explain": "bin/laya-explain.mjs"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
